<div>
  <div>
    <div>
      <h1>ログイン画面</h1>
      <div>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div>
            メール：<%= f.email_field :email, placeholder: "Eメール" %>
          </div>

          <div>
            パスワード：<%= f.password_field :password, placeholder: "パスワード" %>
          </div>

          <%= f.submit "ログイン" %>
        <% end %>
        <a href="#"> パスワードを忘れた？</a>
      </div>
    </div>

    <div style="width: 23rem;">
      <div>
        アカウントを持っていない？
        <%= link_to "サインアップ", new_user_registration_path %>
      </div>
    </div>
  </div>
</div>