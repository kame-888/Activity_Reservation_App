<div>
  <div>
    <div style="width: 23rem;">
      <h1>サインアップ画面</h1>

      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <div>
            苗字：<%= f.text_field :last_name, placeholder: "苗字" %>
          </div>
          
          <div>
            名前：<%= f.text_field :first_name, placeholder: "名前" %>
          </div>
          
          <div>
            メール：<%= f.email_field :email, placeholder: "Eメール" %>
          </div>

          <div>
            パスワード：<%= f.password_field :password, placeholder: "パスワード" %>
          </div>

          <div>
            パスワード確認：<%= f.password_field :password_confirmation, placeholder: "パスワード確認" %>
          </div>

          <div>
            アイコン用画像：<%= f.file_field :avatar, class: "form-control" %>
          </div>

          <%= f.submit "サインアップ" %>
        <% end %>
      </div>
    </div>

    <div style="width: 23rem;">
      <div>
        既にアカウントを持っている？
        <%= link_to "サインイン", new_user_session_path %>
      </div>
    </div>
  </div>
</div>